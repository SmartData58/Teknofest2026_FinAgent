    "goals_heading": "Project Goals",
    "goals": {
      "1": "Data Collection: Collect 100+ campaign texts from at least 5 participation banks across at least 3 distinct product categories.",
      "2": "Information Extraction Accuracy: Achieve over 90% accuracy in extracted profit rates, terms, fees, and reward amounts.",
      "3": "Dashboard Development: Complete an interactive dashboard enabling interbank comparisons, filtering, and sorting capabilities.",
      "4": "Chatbot Functionality: Deploy an operational chatbot answering natural language queries like 'What is Bank A's mortgage rate?' or 'Which bank has the lowest profit rate?'.",
      "5": "On-Premise Compatibility: Verify system operation on a single local server without external dependencies."
    },
