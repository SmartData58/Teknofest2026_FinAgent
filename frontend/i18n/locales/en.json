    "summary": {
      "heading": "Project Summary",
      "name_label": "Project Name",
      "purpose_label": "Project Purpose",
      "purpose_text": "To automatically extract financial information such as profit share rates, maturities, fees, and rewards from natural language campaign texts published on participation banks' websites, standardize this information, and present it to users via dashboards and chatbots.",
      "problem_label": "Problem Definition",
      "problem_text": "In participation banking, campaign texts are written in different formats with varying terminology, making manual comparison difficult. This delays bank employees and customers from selecting the most advantageous product.",
      "solution_label": "Solution Approach",
      "solution_text": "Data collection via web scraping, Turkish text preprocessing and regex-based information extraction, intent analysis and natural language generation using the large language model provided via the competition Evren API, transforming extracted data into standardized comparable formats, and presenting results via interactive dashboards and QA chatbot."
    },
