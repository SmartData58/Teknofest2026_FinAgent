# =============================================================================
# .env.ornek — SmartData (team28) TEKNOFEST 2026
# Bu dosya GIT'E GİRER. Gerçek anahtar İÇERMEZ.
# Kullanım: cp .env.ornek .env  ve boş alanları doldurun.
#
# 🔒 GİZLİ. Repoya ASLA girmemeli:
#       echo ".env" >> .gitignore
#       git rm --cached .env          (zaten commit'lendiyse)
# Anahtarlar ekran görüntüsü/sohbet yoluyla paylaşıldıysa yarışma ekibinden
# YENİLENMESİNİ isteyin — sızmış bir anahtar kotanızı tüketebilir ya da vektör
# veritabanınızı silebilir.
#
# 📍 KONUM: bu dosya REPO KÖKÜNDE olmalı (docker-compose.yml'nin yanında).
# İki iş birden yapar:
#   1) compose'daki ${MONGO_USER} gibi yer tutucuları doldurur
#   2) `env_file: .env` sayesinde backend/scraper konteynerlerine enjekte edilir
#
# ⚠️ Aşağıdaki HER DEĞİŞKEN kodda gerçekten okunuyor. Uydurma anahtar yok;
# hepsi `os.getenv(...)` çağrılarıyla eşleşiyor.
# =============================================================================


# =============================================================================
# 1) YARIŞMA LLM SERVİSİ  (evren_client.py)
# =============================================================================
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=buraya-kendi-anahtariniz

# Kullanıcıya giden cevap. TR-MMLU %79,6.
EVREN_MODEL=llm-large
# Ajanlar (öneri, denetim, çoklu-sorgu, HyDE). Medyan 0,91sn.
EVREN_MODEL_HIZLI=llm-fast
# 8B yönlendirici: görsel-niyet / derin-arama gibi TEK KELİMELİK kararlar.
# Büyük modeli meşgul etmez.
EVREN_MODEL_ROUTER=router

# 🚨 ÖLÇÜMLE BELİRLENDİ (llm_teshis.py). llm-large bir MUHAKEME modeli ve
# düşünme adımları bu bütçeden düşüyor. Gerçek ölçüm:
#     kısa prompt : içerik   162 krktr | muhakeme 5.128 krktr | 975 token
#     77 kampanya : içerik 2.177 krktr | muhakeme 9.244 krktr
# Yani bütçenin ~%85'ini kullanıcının HİÇ GÖRMEDİĞİ düşünme tüketiyor.
# 2048 ile model, uzun bağlamda cevabı YAZMAYA BAŞLAMADAN bütçeyi bitiriyor
# (finish_reason='length') ve ekranda tablo dururken "bilgi bulamadım" yazıyordu.
# Bağlam penceresi 262.144 token; bu bir kota değil ÜST SINIR — kullanılmayan
# token maliyet değildir, yani bol tutmanın zararı yok.
# 0 yazarsan alan isteğe HİÇ konmaz (sunucunun kendi varsayılanı geçerli olur).
EVREN_MAX_TOKENS=16384
EVREN_TIMEOUT=180

# --- Muhakeme (thinking) ------------------------------------------------------
# Ölçümde uzun promptta İLK TOKEN 17,4 saniyede düştü; çünkü model önce 9.244
# karakter düşünüyor ve bu kullanıcıya AKMIYOR — 17 saniye boş ekran.
# Qwen/vLLM bunu kapatabiliyor: chat_template_kwargs.enable_thinking=false
#   acik   : düşünme açık (kodun varsayılanı)
#   kapali : kapatmayı DENE — sunucu desteklemezse evren_client 400 alıp alanı
#            atarak isteği tekrarlar, sistem BOZULMAZ.
# ⚠️ Kapatmadan önce kaliteyi ölç: muhakeme, çok bankalı kıyaslama gibi
# sorularda gerçekten yardımcı olabilir. Karşılaştırma için:
#     python llm_teshis.py          -> [4] bölümü iki durumu da gösterir
# 📌 KARAR: kapali. Gerekçe canlı ölçüm (/health -> kullanim):
#     ilk_token_p50 46,3sn | toplam 48,9sn | cikti 5.171 token
#     -> sürenin %95'i, kullanıcının GÖRMEDİĞİ düşünme adımlarında geçiyordu.
# Açıp kapatıp aynı soruyu sorun; /health'teki ilk_token_p50 ve toplam_token
# farkı kararı tek bakışta gösterir.
EVREN_DUSUNME=kapali

# 🚨 IPv6 zaman aşımı düzeltmesi. Ölçüm (gecikme_teshis.py):
#      DNS varsayılan 11,30sn   |   sadece IPv4 0,04sn
# Sunucunun AAAA kaydı yok; sistem 11 saniye bekleyip IPv4'e düşüyordu ve bu
# bedel HER YENİ BAĞLANTIDA ödeniyordu. Bu ayar soketi doğrudan IPv4'e bağlar.
EVREN_IPV4=true

# Model ısıtma: her modelin İLK isteği ~15sn (sunucuda yükleniyor), sonrakiler
# <1sn. Arka planda bu aralıkla minik istek atılır. 0 = kapalı.
EVREN_ISITMA_ARALIGI=240


# =============================================================================
# 2) EMBEDDING
# =============================================================================
# bge-m3-embed -> 1024 boyut, R@1 0,95
# embed        -> 2560 boyut ⚠️ buna geçerseniz Qdrant koleksiyonu 2560 ile
#                 SIFIRDAN kurulmalı: python -m chatbot.indexing
EVREN_EMBED_MODEL=bge-m3-embed
EVREN_EMBED_BATCH=64


# =============================================================================
# 3) RERANK — ŞU AN KAPALI (EVREN_RERANK=false)
# =============================================================================
# ⚠️ Dokümantasyonun kendi ölçümü rerank için "R@1 0,95 -> 0,55, önerilmez"
# diyor. Bunu görmezden gelmiyoruz, ama o ölçümün bizim kullanımımızla AYNI
# olmayabileceğini de not ediyoruz: dokümandaki senaryo rerank'i tek başına
# bir GETİRİCİ gibi değerlendiriyor olabilir. Bizim hattımızda rerank yalnızca
# vektör aramanın ZATEN getirdiği ilk K belgeyi YENİDEN SIRALAYIP kısıyor —
# yani aday kümesini değiştirmiyor, sadece sırasını düzeltiyor. Bu iki farklı
# iştir ve sonuçları farklı olabilir.
#
# Bu yüzden doğru yol tartışmak değil ÖLÇMEK. A/B için:
#     EVREN_RERANK=false -> python test_buyuk.py --kat liste,banka_filtre,kiyas \
#                              --kayit rerank_kapali.json
#     EVREN_RERANK=true  -> python test_buyuk.py --kat liste,banka_filtre,kiyas \
#                              --kayit rerank_acik.json
# İki JSON'daki "gecti" sayılarını ve "sure" medyanlarını karşılaştır.
# Rerank her istekte fazladan bir API çağrısıdır; kaliteyi ölçülebilir biçimde
# artırmıyorsa yalnızca gecikme ekler.
#
# 🛡️ Güvenlik ağı: rerank başarısız olursa (HTTP hatası, biçim uyuşmazlığı,
# zaman aşımı) evren_client BOŞ LİSTE döner ve generate_response belgelerin
# ORİJİNAL sırasını korur. Yani rerank hiçbir koşulda cevabı engellemez.
EVREN_RERANK=false
EVREN_RERANK_MODEL=rerank


# =============================================================================
# 4) QDRANT (yarışma sunucusu)
# =============================================================================
# url + port 443 + prefix(takım) ayrı ayrı veriliyor (docs 12. bölüm).
EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr
EVREN_TEAM=team28
EVREN_QDRANT_KEY=buraya-kendi-qdrant-anahtariniz
EVREN_QDRANT_TIMEOUT=600

# Eski kod yolları bu iki adı okuyorsa diye (evren_client bunlara DÜŞER):
QDRANT_HOST=https://evren-vektor.ssyz.org.tr
QDRANT_API_KEY=buraya-kendi-qdrant-anahtariniz


# =============================================================================
# 5) MONGODB
# =============================================================================
# Bu üçü hem compose'daki ${...} yer tutucularını doldurur hem scraper'a gider.
MONGO_USER=admin
MONGO_PASSWORD=degistirin
MONGO_DB_NAME=smartdata

# ⚠️ Host adı ORTAMA GÖRE DEĞİŞİR:
#   • Docker içinden çalışıyorsan  -> mongodb   (compose bunu zaten enjekte eder)
#   • Host'tan script çalıştırıyorsan (testapi.py, mongo_kontrol.py,
#     python -m chatbot.indexing) -> localhost
# Aşağıdaki değer HOST'tan çalıştırma içindir; konteyner içinde
# docker-compose.yml'deki `environment:` bloğu bunu EZER (compose'da
# environment > env_file), yani iki ortam da doğru çalışır.
MONGO_URI=mongodb://admin:PAROLANIZ@localhost:27017/?authSource=admin


# =============================================================================
# 6) REDIS
# =============================================================================
# Üç ad da veriliyor (REDIS_HOST/PORT/URL) — chatbot/redis_cache.py hangisini
# okursa okusun çalışsın diye. Konteyner içinde compose zaten REDIS_HOST=redis
# enjekte eder ve env_file'ı EZER; buradaki değerler host'tan çalıştırma içindir.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Açılışta Redis önbelleğini temizle. Kapatmak için 0.
# ⚠️ Yarışma demosundan HEMEN ÖNCE 0 yapmayı düşünün: sıcak önbellek,
# jüri karşısında tekrarlanan soruları anında cevaplar.
STARTUP_CACHE_FLUSH=1


# =============================================================================
# 7) AJAN DAVRANIŞI  (chatbot/agents.py)
# =============================================================================
# Supervisor yerel Ollama'da 245 cevapta 0 sonuç üretmişti (ortalama 55,1sn) ve
# kapatılmıştı. Yeni serviste bir ajan çağrısı saniyeler sürdüğü için tekrar
# açıldı. Cevap süresi yine şişerse ilk kapatılacak şey budur.
SUPERVISOR_AKTIF=true
AGENT_TIMEOUT_SUPERVISOR=30

# Melez görsel-niyet katmanı: regex kararsız kalırsa LLM'e sorar.
GORSEL_LLM_FALLBACK=true
AGENT_TIMEOUT_GORSEL=15

# Text-to-Mongo ajanı: auto | always | never
TEXT_TO_MONGO=auto

AGENT_TIMEOUT_KISA=30
AGENT_TIMEOUT_UZUN=60
AGENT_TIMEOUT_ONERI=30


# =============================================================================
# 8) GÜVENLİK (guard modeli)
# =============================================================================
# Kullanıcı mesajını ve yüklenen dosya içeriğini 4B güvenlik modeliyle tarar.
# ⚠️ Varsayılan olarak SADECE İŞARETLER, ENGELLEMEZ. Gerekçe: bir banka
# asistanında yanlış pozitif (meşru bir kampanya sorusunu reddetmek) jüri
# önünde, kaçırılan nadir bir saldırıdan daha çok zarar verir.
# Gerçekten engellemesini istersen: GUARD_ENGELLE=true
#
# 📌 ŞU AN ENGELLEME AÇIK (true). Bilinçliyse sorun yok; ama sunum öncesi
# test edin: guard modeli meşru bir kampanya sorusunu yanlışlıkla
# engellerse jüri önünde sistem çalışmıyor gibi görünür.
#     python test_buyuk.py --kat enjeksiyon,kapsam_disi,liste
GUARD_AKTIF=true
GUARD_ENGELLE=true
EVREN_GUARD_MODEL=guard


# =============================================================================
# 9) GÖRSEL YÜKLEME
# =============================================================================
# Kampanya ekran görüntüleri doğrudan modele gider (OCR atlanır).
# İstek başına en fazla 2 görsel — üçüncüsü HTTP 400 döndürür (docs).
EVREN_MAKS_GORSEL=2


# =============================================================================
# 10) UYGULAMA
# =============================================================================
# /admin/reindex ucunu korur. AYARLI DEĞİLSE UÇ HERKESE AÇIKTIR ve bu uç
# Qdrant koleksiyonunu SIFIRDAN kurar (yani silebilir). Yarışma ortamında
# mutlaka doldurun — aşağıdaki değeri KENDİNİZ rastgele üretin:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=python -c "import secrets; print(secrets.token_urlsafe(32))" ile uretin

# pipeline.py ADIM 4, chatbot paketini import edemezse bu adrese POST atar.
# Konteyner içinden servis adı + İÇ port kullanılır (host'a açılan 8003 DEĞİL).
CHATBOT_SERVICE_URL=http://backend:8000

SCRAPER_URL=http://scraper:8002/scrape
TEMP_DIR=./temp


# =============================================================================
# ❌ KALDIRILDI — artık hiçbir kod okumuyor:
#   HF_TOKEN            (embedding/reranker/llm konteynerleri silindi)
#   OLLAMA_NUM_PREDICT  ⚠️ '=' işareti YOKTU — bozuk satır
#   OLLAMA_NUM_CTX      ⚠️ '=' işareti YOKTU — bozuk satır
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB  (compose'da postgres yok)
#   EMBEDDING_API_URL / RERANKER_API_URL / LLM_API_URL
#
# 📌 Yarışma arayüzü girişi (backend KULLANMAZ, sadece kayıt için):
#      kullanıcı : <takim-hesabiniz>
#      parola    : <yarisma panelinden alin>
#      docs      : https://evren-teknofest.ssyz.org.tr/
# =============================================================================