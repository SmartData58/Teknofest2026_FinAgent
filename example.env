# =============================================================================
# .env.ornek — ŞABLON. Bu dosya GİT'E GİRER, gerçek .env GİRMEZ.
#
# KURULUM
#   Linux/macOS :  cp .env.ornek .env
#   PowerShell  :  Copy-Item .env.ornek .env
#   sonra BURAYA_YAPISTIR yazan yerleri doldur.
#
# 🔒 ÖNCE ŞUNU YAP — anahtar sızdırmanın en sık yolu bu adımın atlanmasıdır:
#   echo ".env" >> .gitignore
#   git rm --cached .env          # .env zaten commit'lendiyse takipten çıkar
#
# ⚠️ `git rm --cached` dosyayı yalnızca BUNDAN SONRAKİ commit'lerden çıkarır.
# Anahtar geçmişte bir commit'e girdiyse orada DURMAYA DEVAM EDER; depo
# private olsa bile klonlayan herkes görür. Bu durumda tek doğru çözüm
# anahtarı YENİLETMEKTİR (yarışma ekibinden yeni anahtar iste), geçmişi
# temizlemeye çalışmak değil.
#
# 📍 KONUM: repo kökünde, docker-compose.yml'nin yanında. İki iş yapar:
#   1) compose'daki ${MONGO_USER} gibi yer tutucuları doldurur
#   2) `env_file: .env` ile backend/scraper konteynerlerine enjekte edilir
#
# Aşağıdaki HER değişken kodda gerçekten okunuyor (bagimlilik_denetimi.py
# mantığıyla os.getenv çağrılarından çıkarıldı). Uydurma anahtar yok.
# =============================================================================


# =============================================================================
# 1) YARIŞMA LLM SERVİSİ  (evren_client.py)
# =============================================================================
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=sk-evren-<TAKIM>-BURAYA_YAPISTIR

# Kullanıcıya giden cevap. TR-MMLU %79,6.
EVREN_MODEL=llm-large
# Ajanlar (öneri, denetim, çoklu-sorgu, HyDE). Medyan 0,91sn.
EVREN_MODEL_HIZLI=llm-fast
# 8B yönlendirici: görsel-niyet / derin-arama gibi TEK KELİMELİK kararlar.
EVREN_MODEL_ROUTER=router

# 🚨 ÖLÇÜMLE BELİRLENDİ (llm_teshis.py). llm-large bir MUHAKEME modeli;
# düşünme adımları bu bütçeden düşer. Gerçek ölçüm:
#     kısa prompt : içerik   162 krktr | muhakeme 5.128 krktr | 975 token
#     77 kampanya : içerik 2.177 krktr | muhakeme 9.244 krktr
# Bütçenin ~%85'ini kullanıcının HİÇ GÖRMEDİĞİ düşünme tüketiyor. 2048 ile
# model uzun bağlamda cevabı YAZMADAN bütçeyi bitiriyor (finish_reason='length')
# ve ekranda tablo dururken "bilgi bulamadım" yazıyordu.
# Bağlam 262.144 token; bu bir kota değil ÜST SINIR, bol tutmanın zararı yok.
# 0 yazarsan alan isteğe HİÇ konmaz (sunucu varsayılanı geçerli olur).
EVREN_MAX_TOKENS=16384
EVREN_TIMEOUT=180

# --- Muhakeme (thinking) ------------------------------------------------------
# Uzun promptta İLK TOKEN 17,4sn'de düştü: model önce 9.244 karakter düşünüyor
# ve bu kullanıcıya AKMIYOR. Qwen/vLLM kapatabiliyor.
#   acik   : varsayılan
#   kapali : kapatmayı DENE — sunucu desteklemezse evren_client 400 alıp alanı
#            atarak tekrarlar, sistem BOZULMAZ.
# Karşılaştırma:  python llm_teshis.py   -> [4] bölümü
EVREN_DUSUNME=acik

# 🚨 IPv6 zaman aşımı düzeltmesi. Ölçüm (gecikme_teshis.py):
#     DNS varsayılan 11,30sn   |   sadece IPv4 0,04sn
# Sunucunun AAAA kaydı yok; sistem 11 saniye bekleyip IPv4'e düşüyordu ve bu
# bedel HER YENİ BAĞLANTIDA ödeniyordu.
EVREN_IPV4=true

# Model ısıtma: her modelin İLK isteği ~15sn (sunucuda yükleniyor), sonrakiler
# <1sn. Arka planda bu aralıkla minik istek atılır. 0 = kapalı.
EVREN_ISITMA_ARALIGI=240


# =============================================================================
# 2) EMBEDDING
# =============================================================================
# bge-m3-embed -> 1024 boyut, R@1 0,95
# embed        -> 2560 boyut ⚠️ buna geçersen Qdrant koleksiyonu SIFIRDAN
#                 kurulmalı:  python -m chatbot.indexing
EVREN_EMBED_MODEL=bge-m3-embed
EVREN_EMBED_BATCH=64


# =============================================================================
# 3) RERANK
# =============================================================================
# ⚠️ Dokümantasyonun kendi ölçümü: "R@1 0,95 -> 0,55 (önerilmez)".
# Ama o ölçüm rerank'i tek başına bir GETİRİCİ gibi değerlendiriyor olabilir;
# bu hatta rerank yalnızca vektör aramanın ZATEN getirdiği ilk K belgeyi
# yeniden sıralayıp kısıyor — aday kümesini değiştirmiyor. Farklı iş.
# Kararı ölçerek ver (A/B):
#     false -> python test_buyuk.py --kat liste,banka_filtre,kiyas --kayit rerank_kapali.json
#     true  -> python test_buyuk.py --kat liste,banka_filtre,kiyas --kayit rerank_acik.json
# "gecti" sayılarını ve "sure" medyanlarını karşılaştır.
# Başarısız olursa boş liste döner, belgeler orijinal sırada kalır — cevap
# hiçbir koşulda engellenmez.
EVREN_RERANK=true
EVREN_RERANK_MODEL=rerank


# =============================================================================
# 4) QDRANT (yarışma sunucusu)
# =============================================================================
# url + port 443 + prefix(takım) ayrı ayrı verilir (docs 12. bölüm).
# prefix verilmezse istekler /team28/collections yerine köke gider -> 404.
EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr
EVREN_TEAM=<TAKIM_ADI>
EVREN_QDRANT_KEY=qdr-<TAKIM>-BURAYA_YAPISTIR
EVREN_QDRANT_TIMEOUT=600

# Eski kod yolları bu iki adı okuyorsa diye (aynı değerler):
QDRANT_HOST=https://evren-vektor.ssyz.org.tr
QDRANT_API_KEY=qdr-<TAKIM>-BURAYA_YAPISTIR

# 💡 YEREL YEDEK: yarışma Qdrant'ı düşerse
#     docker compose --profile yerel-vektor up -d qdrant
#     EVREN_QDRANT_URL=http://qdrant:6333
#     EVREN_QDRANT_KEY=      (boş)
#     EVREN_TEAM=            (boş)
#     python -m chatbot.indexing
# Kod değişikliği gerekmiyor.


# =============================================================================
# 5) MONGODB
# =============================================================================
MONGO_USER=admin
MONGO_PASSWORD=DEGISTIR_GUCLU_BIR_SIFRE
MONGO_DB_NAME=smartdata

# ⚠️ Host adı ORTAMA GÖRE DEĞİŞİR:
#   • Docker İÇİNDEN         -> mongodb   (compose bunu zaten enjekte eder)
#   • HOST'tan script/test   -> localhost (testapi.py, mongo_kontrol.py,
#                               python -m chatbot.indexing)
# Aşağıdaki değer HOST içindir; konteynerde compose'un `environment` bloğu
# bunu EZER (compose'da environment > env_file), yani iki ortam da doğru çalışır.
MONGO_URI=mongodb://admin:DEGISTIR_GUCLU_BIR_SIFRE@localhost:27017/?authSource=admin


# =============================================================================
# 6) REDIS
# =============================================================================
# ⚠️ Değişken ADINI chatbot/redis_cache.py'den doğrula; kod hangisini
# okuyorsa onu bırak, diğerini sil.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Açılışta Redis önbelleğini temizle. Kapatmak için 0.
# 💡 Demodan HEMEN ÖNCE 0 yapmayı düşün: sıcak önbellek, jüri karşısında
# tekrarlanan soruları anında cevaplar.
STARTUP_CACHE_FLUSH=1


# =============================================================================
# 7) AJAN DAVRANIŞI  (chatbot/agents.py)
# =============================================================================
# Supervisor yerel Ollama'da 245 cevapta 0 sonuç üretmişti (ort. 55,1sn) ve
# kapatılmıştı. Yeni serviste ajan çağrısı saniyeler sürdüğü için açık.
# Cevap süresi yine şişerse ilk kapatılacak şey budur.
SUPERVISOR_AKTIF=true
AGENT_TIMEOUT_SUPERVISOR=30

# Melez görsel-niyet katmanı: regex kararsız kalırsa LLM'e sorar.
GORSEL_LLM_FALLBACK=true
AGENT_TIMEOUT_GORSEL=15

# Text-to-Mongo ajanı: auto | always | never
TEXT_TO_MONGO=auto

AGENT_TIMEOUT_KISA=30
AGENT_TIMEOUT_UZUN=60
AGENT_TIMEOUT_ONERI=30


# =============================================================================
# 8) GÜVENLİK (guard modeli)
# =============================================================================
# Kullanıcı mesajını ve yüklenen dosya içeriğini 4B güvenlik modeliyle tarar.
# ⚠️ Varsayılan olarak SADECE İŞARETLER, ENGELLEMEZ. Gerekçe: bir banka
# asistanında yanlış pozitif (meşru bir kampanya sorusunu reddetmek) jüri
# önünde, kaçırılan nadir bir saldırıdan daha çok zarar verir.
GUARD_AKTIF=true
GUARD_ENGELLE=false
EVREN_GUARD_MODEL=guard


# =============================================================================
# 9) GÖRSEL YÜKLEME
# =============================================================================
# Kampanya ekran görüntüleri OCR'ı ATLAYIP doğrudan modele gider.
# İstek başına en fazla 2 görsel — üçüncüsü HTTP 400 döndürür (docs).
# (PDF/docx hâlâ yerel OCR'dan geçer.)
EVREN_MAKS_GORSEL=2


# =============================================================================
# 10) UYGULAMA
# =============================================================================
# 🔐 /admin/reindex ucunu korur. BOŞ BIRAKILIRSA UÇ HERKESE AÇIKTIR ve bu uç
# Qdrant koleksiyonunu SIFIRDAN kurar — yani mevcut vektörleri siler.
# Kendi değerini üret:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=BURAYA_URETTIGIN_TOKEN

# pipeline.py ADIM 4, chatbot paketini import edemezse bu adrese POST atar.
# Konteyner içinden SERVİS ADI + İÇ PORT kullanılır (host'a açılan 8003 DEĞİL).
CHATBOT_SERVICE_URL=http://backend:8000

SCRAPER_URL=http://scraper:8002/scrape
TEMP_DIR=./temp


# =============================================================================
# ❌ ARTIK KULLANILMIYOR — eski .env'de kalmışsa sil:
#   HF_TOKEN                            (yerel model indirmiyoruz)
#   OLLAMA_NUM_PREDICT / OLLAMA_NUM_CTX ('=' işareti bile yoktu, bozuk satır)
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB   (compose'da Postgres yok)
#   EMBEDDING_API_URL / RERANKER_API_URL / LLM_API_URL (servisler kaldırıldı)
#
# 📌 Yarışma arayüzü girişi BU DOSYAYA YAZILMAZ. Backend zaten kullanmıyor;
# takım içinde parola yöneticisiyle paylaşın, repoya koymayın.
# =============================================================================